# Copy to .env for local dev. Never commit the real .env (see .gitignore).
# In CI/production these are injected via GitHub Actions secrets, not this file.

NODE_ENV=development
PORT=4000

# Postgres connection
DATABASE_URL=postgresql://quokkaquest:changeme@localhost:5432/quokkaquest

# JWT signing secret — generate a strong random value for real use
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# bcrypt cost factor
BCRYPT_SALT_ROUNDS=12
